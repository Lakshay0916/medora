<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgPatientAvatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/doc1"
            android:contentDescription="Patient Avatar"
            android:background="#E0E0E0"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvPatientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPatientAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="35 years old"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvLastVisit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last visit: 2 weeks ago"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnViewPatient"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/profile"
            android:contentDescription="View Patient"
            android:padding="12dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView> 